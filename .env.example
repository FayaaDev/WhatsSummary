# Copy to .dev.vars for local development, then fill every required value.
# Keep this example free of credentials. Production uses Worker vars/secrets.

# Required runtime settings
# API root including any version path; /chat/completions is appended.
LLM_BASE_URL=""
LLM_API_KEY="sk-"
LLM_MODEL="gpt-5.6-luna"

# Deployment handoff only: these do not configure DNS, Access, or resources.
# Account confirmed by user. Fill the remaining choices before deployment.
CLOUDFLARE_ACCOUNT_ID=""
PRODUCTION_HOSTNAME=""
ACCESS_APPROVED_EMAIL=""
ACCESS_AUTH_METHOD=""

# Optional runtime overrides (defaults shown; uncomment only to override).
# MAX_UPLOAD_BYTES=2097152
# MAX_TRANSCRIPT_CHARS=500000
# MAX_MESSAGE_CHARS=20000
# MAX_MODEL_OUTPUT_BYTES=262144
# MAX_SYNTHESIS_INPUT_BYTES=3145728
# MAX_REQUEST_BYTES=4194304
# MAX_SUBJECT_CHARS=500
# MAX_BODY_CHARS=500000
# MODEL_TIMEOUT_MS=60000
# MODEL_MAX_ATTEMPTS=3
